# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — only this example file.

# Django Secret Key
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Debug Mode Configuration
# True for local development, False in production
DEBUG=True

# Allowed Hosts Configuration
# Comma-separated, no spaces. 
#In production use your domain, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Email
# Console backend prints emails to the terminal (development).
# In production use django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production security (only used when DEBUG=False)
# Full origins including the scheme, comma-separated, e.g. https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=
# Set to False only if your host or proxy already redirects HTTP to HTTPS
SECURE_SSL_REDIRECT=True
# Seconds browsers must use HTTPS. Start with 3600 once HTTPS works, later 31536000.
SECURE_HSTS_SECONDS=0
